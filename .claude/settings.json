{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run lint:*)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run prettier:verify)",
      "Bash(npx sfdx-lwc-jest:*)",
      "Bash(sf --version)",
      "Bash(sf org list:*)",
      "Bash(sf org display:*)",
      "Bash(sf project deploy preview:*)",
      "Bash(sf project retrieve preview:*)",
      "Bash(sf project deploy validate:*)",
      "Bash(sf data query:*)",
      "Bash(sf sobject describe:*)",
      "Bash(sf sobject list:*)",
      "Bash(sf apex run test:*)",
      "Bash(sf apex get test:*)",
      "Bash(sf apex list log:*)",
      "Bash(sf apex get log:*)",
      "Bash(sf template generate:*)"
    ],
    "ask": [
      "Bash(sf project deploy start:*)",
      "Bash(sf project retrieve start:*)",
      "Bash(sf project delete:*)",
      "Bash(sf apex run --file:*)",
      "Bash(sf apex run -f:*)",
      "Bash(sf data create:*)",
      "Bash(sf data update:*)",
      "Bash(sf data delete:*)",
      "Bash(sf data upsert:*)",
      "Bash(sf data import:*)",
      "Bash(sf org create:*)",
      "Bash(sf org delete:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
